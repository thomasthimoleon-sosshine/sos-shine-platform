# ── Supabase ──────────────────────────────────────────────
# Utilisées par SOS Shine ET la landing SOS Meet (/sos-meet).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
# Clé service role : SERVEUR UNIQUEMENT (jamais exposée au client).
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://sosshine.com

# ── SOS Meet ──────────────────────────────────────────────
# Aucune variable supplémentaire : la waitlist SOS Meet réutilise Supabase ci-dessus.
# En l'absence de ces variables, /api/sosmeet/waitlist bascule en mode simulé (dev)
# pour permettre de tester l'UI sans base.

# ── Notifications push (iPhone et Android) ──
# Sans ces trois clés, tout fonctionne SAUF l'envoi vers le téléphone : la
# cloche et la pastille rouge marchent, mais rien n'arrive quand l'application
# est fermée. Elles n'étaient documentées nulle part, et n'ont donc jamais été
# renseignées — c'est la seule raison pour laquelle le push ne partait pas.
#
# Générer la paire :  npx web-push generate-vapid-keys
# Puis reporter les deux valeurs ici et dans les variables Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:contact@sosshine.com
